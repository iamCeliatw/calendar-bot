# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# Webhook 簽章驗證（LINE Developers → Messaging API → Channel secret）
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_USER_IDS=your_line_user_id_here,another_user_id_here
# 顯示名稱對照（uid:名字，逗號分隔），新增行程時自動加前綴【名字】
LINE_USER_NAMES=your_line_user_id_here:名字A,another_user_id_here:名字B

# Webhook 伺服器埠（本機 python webhook_app.py；Cloud Run 使用平台提供的 PORT）
WEBHOOK_PORT=5000

# Google OAuth token 檔路徑（Cloud Run Secret 掛載時例如 /secrets/token.json）
# GOOGLE_TOKEN_PATH=token.json

# 時區設定
TIMEZONE=Asia/Taipei

# 每日通知時間 (24小時制)
NOTIFY_HOUR=8
NOTIFY_MINUTE=0

# 是否啟用明日預告 (true/false)
ENABLE_TOMORROW_PREVIEW=true

# 是否啟用提醒精靈與 Cloud Tasks 排程提醒
ENABLE_REMINDER=true

# Cloud Tasks 設定（提醒用）
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=asia-east1
REMINDER_TASK_QUEUE=calendar-reminder-queue
TASK_HANDLER_URL=https://your-cloud-run-url/tasks/reminder
REMINDER_TASK_TOKEN=your_random_long_token

# LIFF App IDs（在 LINE Developers Console 建立 LIFF App 後填入）
LIFF_CALENDAR_ID=your_liff_calendar_app_id
LIFF_FORM_ID=your_liff_form_app_id
LIFF_REMINDER_ID=your_liff_reminder_app_id

# 提醒元數據持久化路徑（Cloud Run 需掛載 Volume 或改用 Cloud Storage）
REMINDERS_FILE=data/reminders.json
